      "coverUrl": ".book-info img@src",
      "intro": ".book-intro@text",
      "tocUrl": "a.toc-link@href"
    },
    "ruleToc": {
      "chapterList": ".chapter-list a.chapter",
      "chapterName": "@text",
      "chapterUrl": "@href",
      "nextTocUrl": ""
    },
